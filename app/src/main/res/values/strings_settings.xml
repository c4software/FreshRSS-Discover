<resources>
    <!--
      Écran de réglages (SPECS.md §6). Fichier distinct de `strings.xml` :
      Android fusionne les fichiers de ressources d'un même dossier, et garder
      l'écran dans le sien évite de faire converger plusieurs travaux sur un
      unique fichier.
    -->

    <!-- Compte connecté, en lecture seule : il vient de la session observée. -->
    <string name="settings_section_account">Compte</string>
    <string name="settings_server_label">Adresse du serveur</string>
    <string name="settings_username_label">Identifiant</string>
    <string name="settings_no_session">Aucune session ouverte.</string>

    <!-- Seuils du marquage automatique (SPECS.md §4.5). -->
    <string name="settings_section_reading">Marquage automatique</string>
    <string name="settings_reading_help">Un article devient lu lorsqu\'il est resté suffisamment visible à l\'écran. Les deux conditions doivent être réunies en même temps.</string>
    <string name="settings_visible_fraction_label">Proportion visible</string>
    <string name="settings_visible_fraction_value">au moins %1$d %%</string>
    <string name="settings_continuous_visibility_label">Durée continue</string>
    <string name="settings_continuous_visibility_value">au moins %1$d s</string>

    <!--
      Cache local (SPECS.md §5.1 et §5.3). La taille est un nombre d'articles et
      non un poids en octets : SQLite ne rend pas ses pages au système après une
      suppression, donc des mégaoctets resteraient identiques après une purge.
    -->
    <string name="settings_section_cache">Cache local</string>
    <string name="settings_cache_size_label">Taille du cache</string>
    <!--
      Le séparateur de milliers (`,` en drapeau de format) n'est pas cosmétique :
      « 1240 articles » se lit comme un identifiant, « 1 240 articles » comme une
      quantité. Constaté sur la capture de référence.
    -->
    <plurals name="settings_cache_article_count">
        <item quantity="one">%1$,d article</item>
        <item quantity="other">%1$,d articles</item>
    </plurals>
    <!-- Dit ce que la purge emporterait, seule question que pose le bouton. -->
    <plurals name="settings_cache_purgeable">
        <item quantity="one">dont %1$d déjà lu et transmis au serveur</item>
        <item quantity="other">dont %1$d déjà lus et transmis au serveur</item>
    </plurals>
    <string name="settings_cache_nothing_to_purge">Aucun article lu à supprimer pour l\'instant.</string>
    <string name="settings_purge_cache">Purger le cache</string>
    <!-- Compte rendu après coup : la purge ne demande pas de confirmation avant. -->
    <plurals name="settings_cache_purged">
        <item quantity="one">%1$d article supprimé.</item>
        <item quantity="other">%1$d articles supprimés.</item>
    </plurals>

    <!-- Déconnexion (SPECS.md §3.5) : destructrice, donc confirmée. -->
    <string name="settings_sign_out">Se déconnecter</string>
    <string name="settings_sign_out_dialog_title">Se déconnecter ?</string>
    <string name="settings_sign_out_dialog_message">Le jeton, l\'identifiant et le cache local seront effacés. Il faudra vous reconnecter pour retrouver votre flux.</string>
    <string name="settings_sign_out_confirm">Se déconnecter</string>
    <string name="settings_sign_out_cancel">Annuler</string>

    <!-- À propos. -->
    <string name="settings_section_about">À propos</string>
    <string name="settings_version_label">Version</string>
    <string name="settings_license_label">Licence</string>
    <!-- Correspond au fichier LICENSE à la racine du dépôt. -->
    <string name="settings_license_value">Licence MIT</string>
</resources>
