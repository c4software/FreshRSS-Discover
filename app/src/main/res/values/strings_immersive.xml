<resources>
    <!--
      Immersive view: one article, full screen, flicked vertically (SPECS.md §4.8). A file of its own
      rather than part of `strings.xml`: Android merges the resources of a
      single folder, and keeping this batch separate avoids making several
      pieces of work converge on one file.
    -->

    <!--
      Source line. Same shape as in List mode — the feed name, then the age —
      because SPECS.md §4.3 imposes it, not the presentation: without the
      source, interleaving the feeds would be disorienting.
    -->
    <string name="immersive_article_meta">%1$s · %2$s</string>

    <!--
      What tapping the page does (SPECS.md §4.7): open the article in a custom
      tab. No longer displayed now that the whole page is the command — it
      serves as `onClickLabel`, and that is the only way a screen reader has of
      knowing what the tap triggers.
    -->
    <string name="immersive_open_article">Open the article</string>

    <!--
      Article with no usable link (SPECS.md §4.7): it cannot be opened, and that
      is **shown** rather than expressed as a button with no effect.
    -->
    <string name="immersive_article_no_link">This article provides no link to open.</string>

    <!--
      Offline mode (SPECS.md §5.2). Neither “error” nor “failure”: what the user
      has in front of them works — these are their articles.
    -->
    <string name="immersive_offline_banner">Offline · you are reading the articles already saved</string>
    <string name="immersive_offline_open_blocked">Without a connection, this article cannot be opened. It stays in your feed.</string>
    <string name="immersive_offline_notice_dismiss">Dismiss</string>
</resources>
