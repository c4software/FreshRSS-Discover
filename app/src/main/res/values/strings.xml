<resources>
    <string name="app_name">FreshRSS Discover</string>

    <!-- Navigation -->
    <string name="destination_discover">Discover</string>
    <string name="destination_settings">Paramètres</string>

    <!--
      Libellés courts de la barre de navigation : elle n'a de place que pour une
      ligne. Le titre d'écran, lui, garde le libellé complet.
    -->
    <string name="destination_short_discover">Discover</string>
    <string name="destination_short_settings">Paramètres</string>

    <!--
      Écran d'attente affiché tant qu'une destination n'a pas son écran réel.
      Chaque libellé disparaîtra avec le Goal qui livre l'écran correspondant —
      voir TASKS.md.
    -->
    <string name="placeholder_title">Écran à venir</string>
    <string name="placeholder_body">Cette destination sera livrée par un prochain Goal. Voir TASKS.md.</string>

    <!-- Connexion -->
    <string name="login_title">Connexion à FreshRSS</string>
    <string name="login_intro">Indiquez l\'adresse de votre serveur FreshRSS et vos identifiants.</string>

    <string name="login_server_label">Adresse du serveur</string>
    <string name="login_server_placeholder">rss.exemple.org</string>
    <string name="login_server_help">L\'adresse de votre instance, telle que vous y accédez depuis un navigateur.</string>

    <string name="login_username_label">Identifiant</string>

    <string name="login_password_label">Mot de passe API</string>
    <!--
      Le mot de passe API est la première cause d'échec de connexion, et son
      existence n'est pas évidente : l'écran l'explique d'emblée plutôt que
      d'attendre un échec pour le mentionner (SPECS.md §3.2).
    -->
    <string name="login_password_help">Ce n\'est pas votre mot de passe de connexion. Créez-le dans FreshRSS : Profil → Mot de passe API.</string>
    <string name="login_password_show">Afficher le mot de passe</string>
    <string name="login_password_hide">Masquer le mot de passe</string>

    <string name="login_submit">Se connecter</string>
    <string name="login_submitting">Connexion…</string>

    <string name="login_insecure_warning">Cette connexion n\'est pas chiffrée (http). Vos identifiants circuleront en clair sur le réseau.</string>

    <!--
      Un message par cause (SPECS.md §3.3) : chacune appelle un geste de
      correction différent, et un message générique laisserait l'utilisateur
      chercher au mauvais endroit.
    -->
    <string name="login_error_address_blank">Indiquez l\'adresse de votre serveur.</string>
    <string name="login_error_address_malformed">Cette adresse n\'est pas exploitable. Exemple : rss.exemple.org</string>
    <string name="login_error_address_scheme">Les adresses « %1$s:// » ne sont pas prises en charge. Utilisez https:// ou http://</string>

    <string name="login_error_no_network">Aucune connexion réseau.</string>
    <string name="login_error_server_unreachable">Le serveur ne répond pas. Vérifiez l\'adresse et que le serveur est accessible.</string>
    <string name="login_error_not_freshrss">Cette adresse ne semble pas être un serveur FreshRSS.</string>
    <string name="login_error_api_disabled">L\'API est désactivée sur ce serveur. Activez-la dans FreshRSS : Administration → Authentification → Autoriser l\'accès par API.</string>
    <string name="login_error_invalid_credentials">Identifiant ou mot de passe API refusé. Vérifiez bien qu\'il s\'agit du mot de passe API, et non de celui de connexion.</string>
    <string name="login_error_header_not_forwarded">Vos identifiants sont bons, mais le serveur web ne transmet pas l\'en-tête d\'autorisation à FreshRSS. Corrigez la configuration de votre reverse-proxy.</string>
    <string name="login_error_unexpected">La connexion a échoué pour une raison inattendue.</string>

    <!-- Flux Discover -->

    <!--
      Source et ancienneté sur une même ligne : dans un flux mélangé, la source
      est ce qui rend l'article intelligible (SPECS.md §4.3), et lui donner sa
      propre ligne rognerait le titre sur chaque carte.
    -->
    <string name="discover_article_meta">%1$s · %2$s</string>

    <!--
      Unités abrégées : elles partagent leur ligne avec le nom du flux. Les
      années gardent leur forme longue, « il y a 2 a » ne se lisant pas.
    -->
    <string name="discover_time_just_now">à l\'instant</string>
    <string name="discover_time_minutes">il y a %1$d min</string>
    <string name="discover_time_hours">il y a %1$d h</string>
    <string name="discover_time_days">il y a %1$d j</string>
    <string name="discover_time_months">il y a %1$d mois</string>
    <plurals name="discover_time_years">
        <item quantity="one">il y a %1$d an</item>
        <item quantity="other">il y a %1$d ans</item>
    </plurals>

    <!-- SPECS.md §4.7 : un article sans lien n'est pas cliquable, et le donne à voir. -->
    <string name="discover_article_no_link">Lien indisponible</string>

    <!--
      La fin du flux est dite explicitement : une liste qui cesse simplement de
      s'allonger est indistinguable d'une panne (SPECS.md §4.4).
    -->
    <string name="discover_end_of_feed">Vous êtes à jour. Plus aucun article à lire.</string>

    <string name="discover_empty_title">Rien à lire pour l\'instant</string>
    <string name="discover_empty_body">Tous les articles de vos flux ont été lus. Revenez plus tard.</string>

    <string name="discover_error_no_network">Aucune connexion réseau.</string>
    <string name="discover_error_server_unreachable">Le serveur ne répond pas.</string>
    <string name="discover_error_unexpected">Le chargement a échoué pour une raison inattendue.</string>
    <string name="discover_retry">Réessayer</string>
</resources>
