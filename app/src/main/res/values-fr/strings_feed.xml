<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Description du bouton de rechargement, lue par les lecteurs d'écran.
        L'infinitif plutôt qu'un nom : elle annonce ce que l'appui va faire.
    -->
    <string name="feed_refresh">Recharger le flux</string>

    <!--
        Invitation à recharger un flux qui date (SPECS.md §4.6).

        « Plusieurs heures » plutôt qu'une durée chiffrée : le seuil est une
        décision d'implémentation, et l'annoncer inviterait à le compter.
        Partagée par les deux modes de présentation, d'où sa place ici.
    -->
    <string name="feed_stale_notice">Ce flux date de plusieurs heures.</string>
    <string name="feed_stale_refresh">Recharger</string>
    <!-- Faire taire l'invitation sans recharger, pour qui ne le peut pas maintenant. -->
    <string name="feed_stale_dismiss">Plus tard</string>

    <!--
        Description du bouton de partage, lue par les lecteurs d'écran.
        L'infinitif plutôt qu'un nom, comme `feed_refresh` : elle annonce ce
        que l'appui va faire.
    -->
    <string name="feed_article_share">Partager l\'article</string>

    <!--
        Ce qui part dans le partage : le titre, puis le lien d'origine
        (SPECS.md §4.3). Deux lignes, parce que les messageries qui détectent
        les liens s'arrêtent au retour à la ligne — accolé au titre, le lien
        cesserait souvent d'être cliquable. L'extrait n'y figure pas : il est
        écourté par nous, et le transmettre partagerait notre troncature.
    -->
    <string name="feed_article_share_text">%1$s\n%2$s</string>

    <!--
        Titre du sélecteur de partage. Affiché par Android jusqu'à la
        version 9 ; au-delà, sa feuille de partage impose le sien.
    -->
    <string name="feed_article_share_chooser">Partager l\'article</string>

    <!--
        Toast affiché quand un chargement de page ou un rechargement échoue
        parce que l'API ne répond pas. Il complète le bloc d'échec et son
        « Réessayer », il ne les remplace pas : il rend l'échec visible quand
        ce bloc est sous la ligne de flottaison. Le hors-ligne n'est pas ce
        cas : le bandeau hors ligne porte déjà ce régime (SPECS.md §5.2).
    -->
    <string name="feed_server_unreachable_toast">Serveur injoignable — le flux n\'a pas pu être mis à jour.</string>
</resources>
