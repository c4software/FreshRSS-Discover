  <string name="subscriptions_error_blank">Saisissez d\'abord l\'adresse d\'un flux.</string>
  <string name="subscriptions_error_invalid">Ce n\'est pas une adresse web que le serveur pourrait lire.</string>
  <string name="subscriptions_error_rejected">Le serveur a refusé : aucun flux trouvé à cette adresse, ou il est déjà abonné.</string>
  <string name="subscriptions_error_no_network">Pas de réseau. Vérifiez la connexion, puis réessayez.</string>
  <string name="subscriptions_error_server_unreachable">Le serveur ne répond pas. Réessayez dans un instant.</string>
  <string name="subscriptions_error_session_expired">La session a expiré : reconnectez-vous.</string>
  <string name="subscriptions_error_unexpected">Quelque chose s\'est mal passé côté serveur. Réessayez dans un instant.</string>
</resources>
