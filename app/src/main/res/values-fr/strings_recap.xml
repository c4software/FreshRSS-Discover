<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Description du bouton de récap, lue par les lecteurs d'écran.
        L'infinitif plutôt qu'un nom, comme `feed_refresh` : elle annonce ce
        que l'appui va faire. « Résumer » seul ne dirait pas quoi.
    -->
    <string name="recap_button">Résumer les articles non lus</string>

    <!-- Titre de la feuille, commun à tous les états : il nomme ce qu'elle est. -->
    <string name="recap_title">Récap de vos articles non lus</string>

    <!--
        Affiché avant le téléchargement unique du modèle. Trois choses à
        consentir : c'est un téléchargement, il n'a lieu qu'une fois, et le
        résumé est produit sur l'appareil — rien n'est envoyé nulle part.
    -->
    <string name="recap_download_offer">Le résumé est produit sur votre appareil, et rien n’en sort. Cela demande de télécharger le modèle, une seule fois.</string>
    <!-- Sert d'offre initiale et de nouvel essai : l'action est la même. -->
    <string name="recap_download_action">Télécharger le modèle</string>

    <!--
        Des mégaoctets, pas un pourcentage : la plateforme n'annonce pas la
        taille totale, un dénominateur inventé ferait mentir la barre.
    -->
    <string name="recap_downloading">Téléchargement du modèle… %1$d Mo</string>
    <string name="recap_download_failed">Le téléchargement a échoué. Vérifiez la connexion et réessayez.</string>

    <!-- Le cache n'a rien de non lu : il n'y a rien à résumer. -->
    <string name="recap_empty">Aucun article non lu à résumer.</string>

    <!--
        Pas de bouton réessayer : un second échec immédiat est probable, et le
        bouton de la barre reste le nouvel essai. Fermer est la sortie.
    -->
    <string name="recap_failed">Le résumé n’a pas pu être généré. Réessayez plus tard.</string>
</resources>
