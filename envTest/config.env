# Configuration de la pile de test locale (GOAL-022).
#
# Tout ce que `test-stack.sh` sait du monde extérieur est ici. Rien de secret
# n'y figure et rien ne doit y arriver : ce fichier est versionné, et les
# identifiants qu'il porte n'ouvrent qu'un conteneur jetable sur cette machine.

# ─── Instance FreshRSS ────────────────────────────────────────────────────────

# Le port est publié sur l'hôte. 8088 plutôt que 80 : le port privilégié
# demanderait les droits d'administrateur pour rien.
FRESHRSS_PORT=8088
FRESHRSS_CONTAINER=freshrss-test
FRESHRSS_IMAGE=freshrss/freshrss:latest

FRESHRSS_USER=discover
FRESHRSS_PASSWORD=DiscoverTest2026

# Distinct du mot de passe de connexion, comme le veut FreshRSS — c'est
# précisément la distinction que SPECS.md §3.2 demande d'expliquer à
# l'utilisateur, et la pile de test ne doit pas l'effacer.
FRESHRSS_API_PASSWORD=ApiTest2026

# `10.0.2.2` est l'adresse par laquelle l'émulateur atteint l'hôte : `localhost`
# y désignerait l'émulateur lui-même. C'est l'adresse à saisir dans l'écran de
# connexion, et en `http://` — d'où le défaut trouvé en GOAL-022-T01.
EMULATOR_HOST_ALIAS=10.0.2.2

# ─── Émulateur ────────────────────────────────────────────────────────────────

AVD_NAME=FreshRSS

# L'image système doit être présente dans $ANDROID_HOME/system-images. Le script
# refuse de deviner : il liste ce qu'il trouve plutôt que de télécharger 1,5 Go
# sans le demander.
AVD_API=36
AVD_TAG=google_apis_playstore
AVD_ABI=x86_64

# Pixel 6 : la densité et la définition sur lesquelles les captures Roborazzi
# sont calibrées (411 dp de large, xhdpi — voir ScreenshotTest).
AVD_WIDTH=1080
AVD_HEIGHT=2400
AVD_DENSITY=420
AVD_RAM_MB=4096

APP_ID=fr.vbrosseau.freshrssdiscover
